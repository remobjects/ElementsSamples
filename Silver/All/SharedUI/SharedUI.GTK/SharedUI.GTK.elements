<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{7510BA55-E2DA-4DBE-8487-5D38AC0B2071}</ProjectGuid>
    <RootNamespace>SharedUI.Shared</RootNamespace>
    <OutputType>Executable</OutputType>
    <AssemblyName>SharedUI.GTK</AssemblyName>
    <TargetFramework>.NETCore10.0</TargetFramework>
    <StartupObject>SharedUI.Shared.Program</StartupObject>
    <DefaultUses>RemObjects.Elements.RTL</DefaultUses>
    <ConditionalDefines>GTK</ConditionalDefines>
    <SharedUIPlatform>GTK</SharedUIPlatform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputPath>bin\$(Configuration)</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <ConditionalDefines>DEBUG;GTK</ConditionalDefines>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <ConditionalDefines>GTK</ConditionalDefines>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Elements"><Private>True</Private></Reference>
    <Reference Include="Echoes"><Private>True</Private></Reference>
    <NuGetReference Include="GirCore.Gtk-4.0:[0.8.1]"><Private>True</Private></NuGetReference>
    <Compile Include="Program.swift" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.Echoes.targets" />
  <Import Project="..\SharedUI.Shared\SharedUI.Shared.projitems" Label="Shared" />
</Project>
