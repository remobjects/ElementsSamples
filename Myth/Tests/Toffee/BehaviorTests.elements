    <Compile Include="..\..\All\Command Line\Reading List\Program.myth" />
    <Compile Include="..\..\All\Command Line\Sensor Summary\Program.myth" />
    <Compile Include="..\..\All\Command Line\Trip Budget\Budget.myth" />
    <Compile Include="..\..\All\Command Line\Trip Budget\Program.myth" />
    <Compile Include="..\..\All\Command Line\Word Frequency\Program.myth" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.Toffee.targets" />
</Project>