<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{E20555D9-CE54-4AC9-9F3C-3F2F6994B119}</ProjectGuid>
    <RootNamespace>Samples.Tests</RootNamespace>
    <OutputType>Executable</OutputType>
    <AssemblyName>BehaviorTests</AssemblyName>
    <StartupClass>Samples.Tests.Behavior</StartupClass>
    <DefaultUses>RemObjects.Elements.RTL</DefaultUses>
    <OutputPath>.\bin\$(Configuration)</OutputPath>
    <Architecture>arm64</Architecture>
    <SDK>macOS</SDK>
    <CodeSign>False</CodeSign>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>False</Optimize>
    <EnableAsserts>True</EnableAsserts>
    <GenerateDebugInfo>True</GenerateDebugInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>True</Optimize>
    <EnableAsserts>True</EnableAsserts>
    <GenerateDebugInfo>False</GenerateDebugInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Foundation">
      <Private>True</Private>
    </Reference>
    <Reference Include="rtl">
      <Private>True</Private>
    </Reference>
    <Reference Include="libToffee">
      <Private>True</Private>
    </Reference>
    <Reference Include="libElements">
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Behavior.myth" />
    <Compile Include="..\..\All\Console.myth" />
    <Compile Include="..\..\All\Command Line\Binary Record\Program.myth" />
