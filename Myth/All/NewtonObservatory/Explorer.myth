version 1;
namespace NewtonObservatory;

type Explorer: class {
  static method Navigate(borrowed _screen: TerminalExplorer!): Int32! {
    var _x = 0.0;
    var _y = 0.0;
    var _zoom = 1.0;
    while true {
      readonly var _action = _screen.NextAction(_x, _y, _zoom);
      if _action == ExplorerAction.Left {
        _x = _x - 0.36 / _zoom;
      }
      if _action == ExplorerAction.Right {
        _x = _x + 0.36 / _zoom;
      }
      if _action == ExplorerAction.Up {
        _y = _y + 0.42 / _zoom;
      }
      if _action == ExplorerAction.Down {
        _y = _y - 0.42 / _zoom;
      }
      if _action == ExplorerAction.ZoomIn and _zoom < 100 {
        _zoom = _zoom * 1.25;
      }
      if _action == ExplorerAction.ZoomOut and _zoom > 0.125 {
        _zoom = _zoom / 1.25;
      }
      if _action == ExplorerAction.Reset {
        _x = 0.0;
        _y = 0.0;
        _zoom = 1.0;
      }
      if _action == ExplorerAction.Quit {
        return 0;
      }
    }
  }
}
