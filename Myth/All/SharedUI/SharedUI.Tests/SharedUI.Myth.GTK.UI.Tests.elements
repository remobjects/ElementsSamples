<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{9C84DB68-9503-409E-887F-2100F6ADA2CE}</ProjectGuid>
    <RootNamespace>SharedUI.Shared</RootNamespace>
    <OutputType>Executable</OutputType>
    <AssemblyName>SharedUI.GTK.UI.Tests</AssemblyName>
    <TargetFramework>.NETCore10.0</TargetFramework>
    <StartupClass>SharedUI.Shared.UIProgram</StartupClass>
    <DefaultUses>RemObjects.Elements.RTL</DefaultUses>
    <ConditionalDefines>GTK</ConditionalDefines>
    <SharedUIPlatform>GTK</SharedUIPlatform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputPath>bin\$(Configuration)</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <ConditionalDefines>DEBUG;GTK</ConditionalDefines>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <ConditionalDefines>GTK</ConditionalDefines>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Elements">
      <Private>True</Private>
    </Reference>
    <Reference Include="Echoes">
      <Private>True</Private>
    </Reference>
    <NuGetReference Include="GirCore.Gtk-4.0:[0.8.1]">
      <Private>True</Private>
    </NuGetReference>
    <Compile Include="../SharedUI.GTK/Program.myth" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.Echoes.targets" />
  <Import Project="..\SharedUI.Shared\SharedUI.Shared.projitems" Label="Shared" />
  <ItemGroup>
    <Compile Include="..\SharedUI.Shared\MainWindowController.GTK.myth" />
    <Compile Include="..\SharedUI.Shared\Aliases.myth" />
    <EmbeddedResource Include="..\SharedUI.Shared\MainWindow.ui">
      <LogicalName>MainWindow.ui</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="UIProgram.pas" />
    <Reference Include="System.Console" />
  </ItemGroup>
</Project>