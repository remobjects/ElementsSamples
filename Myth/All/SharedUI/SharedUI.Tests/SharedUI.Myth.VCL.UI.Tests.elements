<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{6E39879D-52B3-4761-A85E-1F9EB7288BD2}</ProjectGuid>
    <RootNamespace>SharedUI.Shared</RootNamespace>
    <OutputType>Executable</OutputType>
    <AssemblyName>SharedUI.VCL.UI.Tests</AssemblyName>
    <StartupClass>SharedUI.Shared.UIProgram</StartupClass>
    <DefaultUses>RemObjects.Elements.RTL</DefaultUses>
    <DelphiSDK>Delphi 13</DelphiSDK>
    <Architecture>x86_64</Architecture>
    <ConditionalDefines>VCL</ConditionalDefines>
    <SharedUIPlatform>VCL</SharedUIPlatform>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputPath>bin\$(Configuration)</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <ConditionalDefines>DEBUG;VCL</ConditionalDefines>
    <Optimize>False</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <ConditionalDefines>VCL</ConditionalDefines>
    <Optimize>True</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Island" />
    <Reference Include="gc" />
    <Reference Include="rtl" />
    <Reference Include="Elements" />
    <Reference Include="Delphi.rtl" />
    <Reference Include="Delphi.vcl" />
    <Reference Include="Island.DelphiSupport" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.Island.Windows.targets" />
  <Import Project="..\SharedUI.Shared\SharedUI.Shared.projitems" Label="Shared" />
  <ItemGroup>
    <Compile Include="..\SharedUI.Shared\MainWindowController.VCL.myth" />
    <Compile Include="..\SharedUI.Shared\Aliases.myth" />
    <EmbeddedResource Include="..\SharedUI.Shared\MainWindow.dfm" />
    <Compile Include="..\SharedUI.Shared\MainWindow.dfm.myth" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="UIProgram.pas" />
  </ItemGroup>
</Project>