<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{34E502DB-DA92-46D2-9E81-146CC8352770}</ProjectGuid>
    <RootNamespace>Samples.WordFrequency</RootNamespace>
    <OutputType>Executable</OutputType>
    <AssemblyName>WordFrequency</AssemblyName>
    <StartupClass>Samples.WordFrequency.WordFrequencyProgram</StartupClass>
    <DefaultUses>RemObjects.Elements.RTL</DefaultUses>
    <OutputPath>.\bin\$(Configuration)</OutputPath>
    <TargetFramework>.NETCore10.0</TargetFramework>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>False</Optimize>
    <EnableAsserts>True</EnableAsserts>
    <GenerateDebugInfo>True</GenerateDebugInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>True</Optimize>
    <EnableAsserts>True</EnableAsserts>
    <GenerateDebugInfo>False</GenerateDebugInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Console" />
    <Reference Include="Elements">
      <Private>True</Private>
    </Reference>
    <Reference Include="Echoes">
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\All\Command Line\Word Frequency\Program.myth" />
    <None Include="..\..\..\All\Command Line\Word Frequency\expected-output.txt" />
    <Compile Include="..\..\..\Echoes\Console.myth" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.Echoes.targets" />
</Project>