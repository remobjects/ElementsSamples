<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{D108C533-14E4-41D2-8FB3-3B24F2CF97AF}</ProjectGuid>
    <RootNamespace>Samples.SensorSummary</RootNamespace>
    <OutputType>Executable</OutputType>
    <AssemblyName>SensorSummary</AssemblyName>
    <StartupClass>Samples.SensorSummary.SensorSummaryProgram</StartupClass>
    <DefaultUses>RemObjects.Elements.RTL</DefaultUses>
    <OutputPath>.\bin\$(Configuration)</OutputPath>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>False</Optimize>
    <EnableAsserts>True</EnableAsserts>
    <GenerateDebugInfo>True</GenerateDebugInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>True</Optimize>
    <EnableAsserts>True</EnableAsserts>
    <GenerateDebugInfo>False</GenerateDebugInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="rt.jar">
      <Private>True</Private>
    </Reference>
    <Reference Include="cooper.jar">
      <Private>True</Private>
    </Reference>
    <Reference Include="elements.jar">
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\All\Command Line\Sensor Summary\Program.myth" />
    <None Include="..\..\..\All\Command Line\Sensor Summary\expected-output.txt" />
    <Compile Include="..\..\..\All\Console.myth" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.Cooper.targets" />
</Project>