<?xml version='1.0' encoding='utf-8'?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{040980B8-9F00-4F42-91D1-81B70DDDB3B5}</ProjectGuid>
    <RootNamespace>Samples.TripBudget</RootNamespace>
    <OutputType>Executable</OutputType>
    <AssemblyName>TripBudget</AssemblyName>
    <StartupClass>Samples.TripBudget.TripBudgetProgram</StartupClass>
    <DefaultUses>RemObjects.Elements.RTL</DefaultUses>
    <OutputPath>.\bin\$(Configuration)</OutputPath>
    <Architecture>arm64</Architecture>
    <SDK>macOS</SDK>
    <CodeSign>False</CodeSign>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>False</Optimize>
    <EnableAsserts>True</EnableAsserts>
    <GenerateDebugInfo>True</GenerateDebugInfo>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>True</Optimize>
    <EnableAsserts>True</EnableAsserts>
    <GenerateDebugInfo>False</GenerateDebugInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="rtl">
      <Private>True</Private>
    </Reference>
    <Reference Include="gc">
      <Private>True</Private>
    </Reference>
    <Reference Include="Island">
      <Private>True</Private>
    </Reference>
    <Reference Include="Elements">
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\All\Command Line\Trip Budget\Program.myth" />
    <Compile Include="..\..\..\All\Command Line\Trip Budget\Budget.myth" />
    <None Include="..\..\..\All\Command Line\Trip Budget\expected-output.txt" />
    <Compile Include="..\..\..\All\Console.myth" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.Island.Darwin.targets" />
</Project>